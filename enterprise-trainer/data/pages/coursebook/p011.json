  "sentencePatterns": {
    "titleUz": "Gap tuzish",
    "introUz": "Joy haqida savol berish va javob berishning 2 ta qolipi.",
    "patterns": [
      {
        "formula": "BIRLIK: Is + the JOY + in + MAMLAKAT? → Yes, it is. / No, it isn't. It's in ...",
        "exampleEn": "Is the Eiffel Tower in Italy? — No, it isn't. It's in France.",
        "exampleUz": "Eyfel minorasi Italiyadami? — Yo'q. U Fransiyada.",
        "explanationUz": "Bitta narsa → 'it' olmoshi → is / isn't."
      },
      {
        "formula": "KO'PLIK: Are + the JOY + in + MAMLAKAT? → Yes, they are. / No, they aren't. They're in ...",
        "exampleEn": "Are the Pyramids in Brazil? — No, they aren't. They're in Egypt.",
        "exampleUz": "Piramidalar Braziliyadami? — Yo'q. Ular Misrda.",
        "explanationUz": "Bir nechta narsa → 'they' olmoshi → are / aren't. 'the Pyramids' -s bilan tugagani uchun ko'plik."
      },
      {
        "formula": "Are you from + MAMLAKAT? → Yes, I am. / No, I'm not.",
        "exampleEn": "Are you from Egypt? — Yes, I am.",
        "exampleUz": "Siz Misrdanmisiz? — Ha, shundayman.",
        "explanationUz": "Tasdiq javobda 'Yes, I am' — 'Yes, I'm' XATO. Inkor javobda esa qisqaradi: 'No, I'm not'."
      }
    ]
  },
