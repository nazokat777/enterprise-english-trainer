    {
      "kind": "grammar",
      "title": "Grammar: have got ('ve got) / has got ('s got)",
      "titleUz": "Grammatika: have got / has got",
      "rule": {
        "titleUz": "have got — egalik bildirish",
        "explanationUz": "'have got' — 'bor' ma'nosini beradi (egalik).\nO'zbekchada 'Menda it bor' deymiz — inglizchada 'I have got a dog'.\n\nEGAGA qarab ikki shakl:\n• I / you / we / they → HAVE got\n• he / she / it → HAS got\n\nOg'zaki nutqda qisqaradi: I've got, he's got.\nDIQQAT: he's — bu 'he is' ham, 'he has' ham bo'lishi mumkin.\nFarqni 'got' aytib beradi: 'he's got' = he HAS got.",
        "affirmative": [
          {
            "subject": "I/you/we/they",
            "full": "I have got",
            "short": "I've got",
            "uz": "menda ... bor"
          },
          {
            "subject": "he/she/it",
            "full": "he has got",
            "short": "he's got",
            "uz": "unda ... bor"
          }
        ],
        "negative": [
          {
            "subject": "I/you/we/they",
            "full": "I have not got",
            "short": "I haven't got",
            "uz": "menda ... yo'q"
          },
          {
            "subject": "he/she/it",
            "full": "he has not got",
            "short": "he hasn't got",
            "uz": "unda ... yo'q"
          }
        ],
        "interrogative": [
          {
            "q": "Have I/you/we/they got ...?",
            "yes": "Yes, I/you/we/they have.",
            "no": "No, I/you/we/they haven't."
          },
          {
            "q": "Has he/she/it got ...?",
            "yes": "Yes, he/she/it has.",
            "no": "No, he/she/it hasn't."
          }
        ],
        "interrogativeNoteUz": "Qisqa javobda 'got' TAKRORLANMAYDI: 'Yes, he has.' — 'Yes, he has got' emas.",
        "exampleEn": "I've got a dog. My dog has got long ears.",
        "exampleUz": "Menda it bor. Itimning quloqlari uzun.",
        "warningUz": "So'roqda 'do/does' ISHLATILMAYDI:\n  'Has he got a car?' — TO'G'RI\n  'Does he have got a car?' — XATO"
      },
