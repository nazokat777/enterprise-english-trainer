  "sentencePatterns": {
    "titleUz": "Gap tuzish",
    "introUz": "Unit 2 ning asosiy grammatikasi — egalik.",
    "patterns": [
      {
        "formula": "EGA + have/has got + NARSA",
        "exampleEn": "I've got a dog. / My dog has got long ears.",
        "exampleUz": "Menda it bor. / Itimning quloqlari uzun.",
        "explanationUz": "I/you/we/they → have got · he/she/it → has got.\nO'zbekchadagi 'menda ... bor' shu qolipga to'g'ri keladi."
      },
      {
        "formula": "SO'ROQ: Have/Has + EGA + got ...?",
        "exampleEn": "Has Pierre got a beard? — No, he hasn't.",
        "exampleUz": "Pierrening soqoli bormi? — Yo'q.",
        "explanationUz": "Fe'l birinchi o'rinda. Qisqa javobda 'got' TAKRORLANMAYDI: 'No, he hasn't' ('hasn't got' emas)."
      },
      {
        "formula": "TA'RIF (3 gap): EGA + be + bo'y/gavda. EGA + have got + soch/ko'z. EGA + can + FE'L.",
        "exampleEn": "He is quite tall and slim. He has got short dark hair and brown eyes. He can play tennis very well.",
        "exampleUz": "U ancha baland va nozik. Uning kalta qora sochi va jigarrang ko'zi bor. U tennisni juda yaxshi o'ynay oladi.",
        "explanationUz": "Odamni ta'riflashning to'liq qolipi. Bo'y/gavda uchun BE, soch/ko'z uchun HAVE GOT, qobiliyat uchun CAN."
      },
      {
        "formula": "3-SHAXS: He/She + FE'L-s",
        "exampleEn": "He lives in Paris. He likes reading.",
        "exampleUz": "U Parijda yashaydi. U o'qishni yoqtiradi.",
        "explanationUz": "he/she/it bilan fe'lga -S qo'shiladi. LEKIN 'can' dan keyin qo'shilmaydi: 'He can play' (plays emas)."
      }
    ]
