  "sentencePatterns": {
    "titleUz": "Gap tuzish",
    "introUz": "Ingliz tilida so'z tartibi qat'iy: EGA + FE'L + qolgani. O'zbekchada fe'l oxirida keladi, inglizchada esa ikkinchi o'rinda — eng ko'p xato shu yerda bo'ladi.",
    "patterns": [
      {
        "formula": "I'm a + KASB",
        "exampleEn": "I'm a musician.",
        "exampleUz": "Men musiqachiman.",
        "explanationUz": "Kasb oldidan a/an ARTIKLI shart. 'I'm musician' — xato. Unli tovush bilan boshlansa an: an artist."
      },
      {
        "formula": "They are + KASB(ko'plik)",
        "exampleEn": "They are farmers.",
        "exampleUz": "Ular dehqonlar.",
        "explanationUz": "Ko'plikda a/an ISHLATILMAYDI, lekin so'zga -s qo'shiladi: farmer → farmers."
      },
      {
        "formula": "EGA + be + from + JOY",
        "exampleEn": "He's from Edinburgh, Scotland.",
        "exampleUz": "U Edinburgdan.",
        "explanationUz": "'from' — dan. Shahar avval, mamlakat keyin, vergul bilan ajratiladi."
      },
      {
        "formula": "EGA + be + SON + years old",
        "exampleEn": "I'm forty years old.",
        "exampleUz": "Men qirq yoshdaman.",
        "explanationUz": "'years old' qo'shilishi kerak. 'I'm forty' ham to'g'ri, lekin to'liq shakli — 'forty years old'."
      },
      {
        "formula": "SO'ROQ: be + EGA + ...?",
        "exampleEn": "Where is he from? / How old is he?",
        "exampleUz": "U qayerdan? / U necha yoshda?",
        "explanationUz": "So'roq gapda fe'l EGADAN OLDIN keladi: 'is he', 'he is' emas. So'roq so'zi (Where, How old, What) eng oldinda turadi."
      }
    ]
