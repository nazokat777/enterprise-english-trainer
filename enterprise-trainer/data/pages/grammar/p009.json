      "kind": "grammar_theory",
      "title": "The Verb \"have got\"",
      "titleUz": "\"have got\" fe'li",
      "rule": {
        "titleUz": "have got — egalik va tavsif",
        "explanationUz": "'have got' — 'bor' ma'nosini beradi.\nO'zbekchada 'Menda mushuk bor' deymiz — inglizchada 'I've got a cat'.\n\nEGAGA qarab ikki shakl:\n• I / you / we / they → HAVE got\n• he / she / it       → HAS got\n\nQAVS ICHIDAGI 'got' nima uchun? Chunki 'got' siz ham bo'ladi:\n  'I have a cat' = 'I have got a cat' — ma'no bir xil.\n  'have got' — Britaniyada ko'proq, og'zaki nutqda.\n  'have'     — AQShda ko'proq, rasmiyroq.",
        "table": [
          {
            "subject": "I",
            "affLong": "I have (got)",
            "affShort": "I've (got)",
            "interrogative": "Have I (got)?",
            "negLong": "I have not (got)",
            "negShort": "I haven't (got)"
          },
          {
            "subject": "you",
            "affLong": "you have (got)",
            "affShort": "you've (got)",
            "interrogative": "Have you (got)?",
            "negLong": "you have not (got)",
            "negShort": "you haven't (got)"
          },
          {
            "subject": "he",
            "affLong": "he has (got)",
            "affShort": "he's (got)",
            "interrogative": "Has he (got)?",
            "negLong": "he has not (got)",
            "negShort": "he hasn't (got)"
          },
          {
            "subject": "she",
            "affLong": "she has (got)",
            "affShort": "she's (got)",
            "interrogative": "Has she (got)?",
            "negLong": "she has not (got)",
            "negShort": "she hasn't (got)"
          },
          {
            "subject": "it",
            "affLong": "it has (got)",
            "affShort": "it's (got)",
            "interrogative": "Has it (got)?",
            "negLong": "it has not (got)",
            "negShort": "it hasn't (got)"
          },
          {
            "subject": "we",
            "affLong": "we have (got)",
            "affShort": "we've (got)",
            "interrogative": "Have we (got)?",
            "negLong": "we have not (got)",
            "negShort": "we haven't (got)"
          },
          {
            "subject": "you",
            "affLong": "you have (got)",
            "affShort": "you've (got)",
            "interrogative": "Have you (got)?",
            "negLong": "you have not (got)",
            "negShort": "you haven't (got)"
          },
          {
            "subject": "they",
            "affLong": "they have (got)",
            "affShort": "they've (got)",
            "interrogative": "Have they (got)?",
            "negLong": "they have not (got)",
            "negShort": "they haven't (got)"
          }
        ],
        "rules": [
          {
            "enRule": "We use the verb have got to express possession.",
            "uzRule": "EGALIK bildirish uchun ishlatiladi.",
            "examples": [
              "I've got a cat.",
              "She's got a red bicycle."
            ],
            "examplesUz": [
              "Menda mushuk bor.",
              "Unda qizil velosiped bor."
            ]
          },
          {
            "enRule": "We also use have got to describe people, animals or things.",
            "uzRule": "Odam, hayvon va narsalarni TASVIRLASH uchun ham ishlatiladi.",
            "examples": [
              "She's got green eyes."
            ],
            "examplesUz": [
              "Uning ko'zi yashil."
            ]
          }
        ],
        "noteUz": "MUHIM: qisqa javobda 'got' TAKRORLANMAYDI.\n  'Have you got a cat?' → 'Yes, I have.' ('Yes, I have got' XATO)",
        "warningUz": "DIQQAT — 'he's' ikki ma'noli:\n  'he's got' = he HAS got  (egalik)\n  'he's tall' = he IS tall  (holat)\n'got' bo'lsa — HAS, bo'lmasa — IS."
      }
    },
    {
      "kind": "grammar_theory",
      "title": "Short answers (have got)",
      "titleUz": "Qisqa javoblar (have got)",
      "rule": {
        "explanationUz": "So'roqqa qisqa javob berishda ASOSIY FE'L takrorlanmaydi — faqat have/has qoladi.",
        "examples": [
          {
            "q": "Have you got a cat?",
            "qUz": "Sizda mushuk bormi?",
            "yes": "Yes, I/we have.",
            "no": "No, I/we haven't."
          },
          {
            "q": "Have they got a brother?",
            "qUz": "Ularning akasi bormi?",
            "yes": "Yes, they have.",
            "no": "No, they haven't."
          },
          {
            "q": "Has he/she/it got blue eyes?",
            "qUz": "Uning ko'zi ko'kmi?",
            "yes": "Yes, he/she/it has.",
            "no": "No, he/she/it hasn't."
          }
        ],
        "keyRules": [
          {
            "enRule": "In short answers we do not use got.",
            "uzRule": "Qisqa javobda 'got' ISHLATILMAYDI.",
            "correct": "Have you got a cat? — Yes, I have.",
            "wrong": "Yes, I have got.",
            "whyUz": "Qisqa javobda faqat yordamchi fe'l qoladi. Bu 'to be' dagi qoida bilan bir xil: 'Yes, he is' ('Yes, he is tall' emas)."
          }
        ]
      }
    },
    {
      "kind": "grammar_theory",
      "title": "The Verb \"can\"",
      "titleUz": "\"can\" fe'li",
      "rule": {
        "titleUz": "can — qobiliyat va iltimos",
        "explanationUz": "'can' — modal fe'l. Uning eng katta afzalligi: BARCHA SHAXSDA BIR XIL.\n\nO'zgarmaydi:\n  I can walk · he can walk · they can walk\n  'he cans' — XATO. -S QO'SHILMAYDI.\n\nO'zidan keyingi fe'l ham o'zgarmaydi:\n  'He can walk' — 'walks' ham, 'to walk' ham EMAS.",
        "table": [
          {
            "subject": "I",
            "affLong": "I can walk",
            "interrogative": "Can I walk?",
            "negLong": "I cannot walk",
            "negShort": "I can't walk"
          },
          {
            "subject": "you",
            "affLong": "you can walk",
            "interrogative": "Can you walk?",
            "negLong": "you cannot walk",
            "negShort": "you can't walk"
          },
          {
            "subject": "he",
            "affLong": "he can walk",
            "interrogative": "Can he walk?",
            "negLong": "he cannot walk",
            "negShort": "he can't walk"
          },
          {
            "subject": "she",
            "affLong": "she can walk",
            "interrogative": "Can she walk?",
            "negLong": "she cannot walk",
            "negShort": "she can't walk"
          },
          {
            "subject": "it",
            "affLong": "it can walk",
            "interrogative": "Can it walk?",
            "negLong": "it cannot walk",
            "negShort": "it can't walk"
          },
          {
            "subject": "we",
            "affLong": "we can walk",
            "interrogative": "Can we walk?",
            "negLong": "we cannot walk",
            "negShort": "we can't walk"
          },
          {
            "subject": "you",
            "affLong": "you can walk",
            "interrogative": "Can you walk?",
            "negLong": "you cannot walk",
            "negShort": "you can't walk"
          },
          {
            "subject": "they",
            "affLong": "they can walk",
            "interrogative": "Can they walk?",
            "negLong": "they cannot walk",
            "negShort": "they can't walk"
          }
        ],
        "rules": [
          {
            "enRule": "We use can to show ability.",
            "uzRule": "QOBILIYAT bildirish uchun.",
            "examples": [
              "He can dance."
            ],
            "examplesUz": [
              "U raqsga tusha oladi."
            ]
          },
          {
            "enRule": "We also use can to express polite requests.",
            "uzRule": "MULOYIM ILTIMOS uchun ham.",
            "examples": [
              "Can you close the window, please?"
            ],
            "examplesUz": [
              "Derazani yopa olasizmi?"
            ]
          }
        ],
        "interrogative": [
          {
            "q": "Can I/you/he, etc ... play the piano?",
            "yes": "Yes, I/you/he, etc can.",
            "no": "No, I/you/he, etc can't."
          }
        ],
        "interrogativeNoteUz": "Qisqa javobda asosiy fe'l takrorlanmaydi: 'Yes, I can.' ('Yes, I can play' emas).",
        "exampleEn": "I can sing well. He can sing well. They can sing well.",
        "exampleUz": "Men yaxshi kuylay olaman. U yaxshi kuylay oladi. Ular yaxshi kuylay oladi.",
        "noteUz": "Uchala gapda ham 'can' o'zgarmadi — mana shu 'can' ning qulayligi.",
        "warningUz": "To'liq inkor shakli — 'cannot', BITTA so'z.\n  'can not' — deyarli ishlatilmaydi\n  'cannot'  — to'g'ri\n  'can't'   — qisqa, og'zaki"
      }
    }
  ],
