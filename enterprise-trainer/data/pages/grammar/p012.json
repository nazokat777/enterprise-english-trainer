    "patterns": [
      {
        "formula": "BE bilan: Is/Are + EGA + ...? → Yes, EGA is/are. / No, EGA isn't/aren't.",
        "exampleEn": "Is he English? — No, he isn't. He's American.",
        "exampleUz": "U inglizmi? — Yo'q. U amerikalik.",
        "explanationUz": "Holat, millat, kasb, yosh, bo'y-gavda uchun."
      },
      {
        "formula": "HAVE GOT bilan: Has/Have + EGA + got ...? → Yes, EGA has/have.",
        "exampleEn": "Has he got short hair? — Yes, he has.",
        "exampleUz": "Uning sochi kaltami? — Ha.",
        "explanationUz": "Egalik va tug'ma xususiyat uchun. Qisqa javobda 'got' YO'Q."
      },
      {
        "formula": "CAN bilan: Can + EGA + FE'L? → Yes, EGA can. / No, EGA can't.",
        "exampleEn": "Can he ski? — Yes, he can.",
        "exampleUz": "U chang'i ucha oladimi? — Ha.",
        "explanationUz": "Qobiliyat uchun. Fe'l asos shaklida, -S yo'q."
      },
      {
        "formula": "SAVOL SO'ZI: Who (odam) · What (narsa) · Where (joy) · How old (yosh)",
        "exampleEn": "Who is she? / What is it? / Where are they? / How old are you?",
        "exampleUz": "U kim? / Bu nima? / Ular qayerda? / Necha yoshdasiz?",
        "explanationUz": "Odam uchun WHO, narsa uchun WHAT. Ikkalasidan keyin ham fe'l egadan OLDIN keladi."
      },
      {
        "formula": "XATO TOPISH: fe'l egaga mos keladimi?",
        "exampleEn": "The Pyramids IS in Cairo → The Pyramids ARE in Cairo.",
        "exampleUz": "",
        "explanationUz": "Har gapda tekshiring: ega birlikmi yoki ko'plikmi?\nKo'plik belgilari: -s (Pyramids, neighbours), 'and' bilan bog'langan ismlar (Mario and Peter)."
      }
    ]
  },
