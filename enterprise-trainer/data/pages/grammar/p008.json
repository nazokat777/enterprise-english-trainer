  "sections": [
    {
      "kind": "grammar_exercise",
      "title": "Word order",
      "titleUz": "So'z tartibi",
      "exercises": [
        {
          "ref": "9",
          "type": "word_order",
          "instructionEn": "Put the words into the correct order to form a sentence, as in the example.",
          "instructionUz": "So'zlarni to'g'ri tartibda joylashtirib gap tuzing.",
          "explanationUz": "Ingliz tilida so'z tartibi QAT'IY:\n• TASDIQ/INKOR: EGA + be + qolgani\n• SO'ROQ: be + EGA + qolgani?\n• SO'ROQ SO'Z bilan: So'roq so'z + be + EGA?\n'not' har doim fe'ldan KEYIN keladi: 'I am not', 'am I not' emas.",
          "items": [
            { "n": 1, "words": ["ice-skater", "an", "is", "she"], "answer": "She is an ice-skater.", "given": true, "whyUz": "EGA(She) + be(is) + an + kasb" },
            { "n": 2, "words": ["Portuguese", "we", "not", "are"], "answer": "We are not Portuguese.", "alt": "We aren't Portuguese.", "whyUz": "not fe'ldan keyin. Millat oldidan a/an yo'q." },
            { "n": 3, "words": ["Black Forest", "in", "is", "the", "Germany"], "answer": "The Black Forest is in Germany.", "whyUz": "'the' joy nomidan oldin. Mamlakat oldidan 'in'." },
            { "n": 4, "words": ["not", "am", "I", "Dutch"], "answer": "I am not Dutch.", "alt": "I'm not Dutch.", "whyUz": "I + am + not + millat" },
            { "n": 5, "words": ["favourite", "is", "your", "what", "sport?"], "answer": "What is your favourite sport?", "alt": "What's your favourite sport?", "whyUz": "So'roq so'zi(What) + be(is) + ega" },
            { "n": 6, "words": ["twenty-two", "old", "we", "years", "are"], "answer": "We are twenty-two years old.", "whyUz": "Yosh qolipi: SON + years old" },
            { "n": 7, "words": ["what", "capital", "Denmark", "of", "is", "the?"], "answer": "What is the capital of Denmark?", "whyUz": "'the capital of' — o'zgarmas ibora" },
            { "n": 8, "words": ["you", "from", "where", "are?"], "answer": "Where are you from?", "whyUz": "'from' gap OXIRIDA qoladi — o'zbekchadan farqli" },
            { "n": 9, "words": ["pasta", "his", "favourite", "is", "food"], "answer": "Pasta is his favourite food.", "alt": "His favourite food is pasta.", "whyUz": "Ikkala tartib ham to'g'ri" },
            { "n": 10, "words": ["are", "New Zealand", "from", "they?"], "answer": "Are they from New Zealand?", "whyUz": "So'roqda fe'l birinchi: Are + they" }
          ]
        }
      ]
    },
    {
      "kind": "grammar_exercise",
      "title": "Question Words: How old, Where, What",
      "titleUz": "So'roq so'zlari: How old, Where, What",
      "exercises": [
        {
          "ref": "10",
          "type": "write_question",
          "instructionEn": "Read the texts, then write the missing questions using how old, where and what, as in the example.",
          "instructionUz": "Matnlarni o'qing, so'ng how old, where va what yordamida yetishmayotgan savollarni yozing.",
          "explanationUz": "JAVOBGA qarab SAVOLNI tiklaysiz — bu juda foydali ko'nikma:\n• Javob yosh bo'lsa → How old ...?\n• Javob joy bo'lsa → Where ...?\n• Javob ism bo'lsa → What's his/her name?\n• Javob kasb bo'lsa → What's his/her job?",
          "texts": [
            { "n": 1, "aboutEn": "Harry Dalton", "facts": { "name": "Harry Dalton", "age": 32, "from": "London, England", "job": "policeman" } },
            { "n": 2, "aboutEn": "Ed", "facts": { "name": "Ed", "relation": "Harry's brother", "age": 30, "job": "vet" } }
          ],
          "items": [
            { "n": 1, "question": "What's his name?", "answer": "Harry Dalton.", "given": true },
            { "n": 2, "question": "How old is he?", "answer": "He's 32.", "whyUz": "Javob yosh → How old" },
            { "n": 3, "question": "Where is he from?", "answer": "He's from London, England.", "whyUz": "Javob joy → Where ... from" },
            { "n": 4, "question": "What's his job?", "answer": "He's a policeman.", "whyUz": "Javob kasb → What's his job" },
            { "n": 5, "question": "What's his name?", "answer": "Ed.", "whyUz": "Javob ism → What's his name" },
            { "n": 6, "question": "How old is he?", "answer": "He's 30.", "whyUz": "Javob yosh → How old" },
            { "n": 7, "question": "What's his job?", "answer": "He's a vet.", "whyUz": "Javob kasb → What's his job" }
          ]
        }
      ]
    },
    {
      "kind": "grammar_exercise",
      "title": "Indefinite Article: A/An",
      "titleUz": "Noaniq artikl: A/An",
      "exercises": [
        {
          "ref": "11",
          "type": "article_choice",
          "instructionEn": "Fill in a or an.",
          "instructionUz": "a yoki an ni qo'ying.",
          "explanationUz": "Qoida: so'zning BIRINCHI TOVUSHIGA qarang.\n• Unli tovush (a, e, i, o, u) → an\n• Undosh tovush → a\nBu sahifadagi 'umbrella' va 'envelope' unli bilan boshlanadi → an.\n'house' da 'h' o'qiladi → undosh → a.",
          "items": [
            { "n": 1, "word": "book", "wordUz": "kitob", "answer": "a", "whyUz": "b — undosh" },
            { "n": 2, "word": "armchair", "wordUz": "kreslo", "answer": "an", "whyUz": "a — unli" },
            { "n": 3, "word": "house", "wordUz": "uy", "answer": "a", "whyUz": "h o'qiladi → undosh" },
            { "n": 4, "word": "orange", "wordUz": "apelsin", "answer": "an", "whyUz": "o — unli" },
            { "n": 5, "word": "elephant", "wordUz": "fil", "answer": "an", "whyUz": "e — unli" },
            { "n": 6, "word": "dog", "wordUz": "it", "answer": "a", "whyUz": "d — undosh" },
            { "n": 7, "word": "tree", "wordUz": "daraxt", "answer": "a", "whyUz": "t — undosh" },
            { "n": 8, "word": "umbrella", "wordUz": "soyabon", "answer": "an", "whyUz": "u bu yerda 'am-' deb o'qiladi → unli" },
            { "n": 9, "word": "envelope", "wordUz": "konvert", "answer": "an", "whyUz": "e — unli" },
            { "n": 10, "word": "watch", "wordUz": "qo'l soati", "answer": "a", "whyUz": "w — undosh" },
            { "n": 11, "word": "clock", "wordUz": "devor soati", "answer": "a", "whyUz": "k — undosh" },
            { "n": 12, "word": "hamburger", "wordUz": "gamburger", "answer": "a", "whyUz": "h o'qiladi → undosh" }
          ]
        }
      ]
    },
    {
      "kind": "vocabulary",
      "title": "Numbers",
      "titleUz": "Sonlar",
      "exercises": [
        {
          "ref": "12",
          "type": "number_to_words",
          "instructionEn": "Write the words for these numbers.",
          "instructionUz": "Bu sonlarni so'z bilan yozing.",
          "explanationUz": "Aralash sonlar CHIZIQCHA bilan yoziladi: 39 = thirty-nine.\nDiqqat: 41 = forty-one ('u' yo'q!), 82 = eighty-two (bitta 't').",
          "items": [
            { "number": 7, "answer": "seven" },
            { "number": 39, "answer": "thirty-nine" },
            { "number": 64, "answer": "sixty-four" },
            { "number": 41, "answer": "forty-one", "whyUz": "forty — 'u' YO'Q" },
            { "number": 82, "answer": "eighty-two" },
            { "number": 54, "answer": "fifty-four" },
            { "number": 10, "answer": "ten" },
            { "number": 11, "answer": "eleven" },
            { "number": 26, "answer": "twenty-six" },
            { "number": 93, "answer": "ninety-three" }
          ]
        },
        {
          "ref": "13",
          "type": "words_to_number",
          "instructionEn": "Write these numbers in figures.",
          "instructionUz": "Bu sonlarni raqam bilan yozing.",
          "explanationUz": "Teskari mashq — so'zni raqamga aylantirasiz. -teen (13-19) va -ty (o'nliklar) ni adashtirmang: eighteen = 18, eighty = 80.",
          "items": [
            { "word": "twenty-one", "answer": 21 },
            { "word": "eighteen", "answer": 18, "whyUz": "-teen → 18 (eighty = 80 emas)" },
            { "word": "fifty", "answer": 50 },
            { "word": "one hundred", "answer": 100 },
            { "word": "seventy-five", "answer": 75 },
            { "word": "ninety-seven", "answer": 97 },
            { "word": "forty-three", "answer": 43 },
            { "word": "sixty-eight", "answer": 68 },
            { "word": "thirty-two", "answer": 32 },
            { "word": "eighty-nine", "answer": 89 }
          ]
        }
      ]
    }
  ],
