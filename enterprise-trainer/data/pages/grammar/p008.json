      },
      {
        "formula": "What + is + the capital of + MAMLAKAT?",
        "exampleEn": "What is the capital of Denmark?",
        "exampleUz": "Daniyaning poytaxti nima?",
        "explanationUz": "'the capital of' — o'zgarmas ibora, 'the' tushmaydi."
      },
      {
        "formula": "How old + is/are + EGA?",
        "exampleEn": "How old is he? — He's 32.",
        "exampleUz": "U necha yoshda? — U 32 yoshda.",
