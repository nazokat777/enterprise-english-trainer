        {
          "ref": "8",
          "type": "article_choice",
          "instructionEn": "Fill in a or an.",
          "instructionUz": "a yoki an ni qo'ying.",
          "explanationUz": "QOIDA: so'zning birinchi TOVUSHIGA qarang.\n• Unli tovush (a, e, i, o, u) → an\n• Undosh tovush → a\n\nSkanerdagi o'quvchi 12 tadan 6 tasini xato qilgan. Sabab — u so'zning MA'NOSIGA yoki tasodifga qarab tanlagan. Aslida faqat BIRINCHI TOVUSH muhim.\nOson tekshiruv: so'zni ovoz chiqarib ayting. Og'zingiz unli bilan ochilsa — an.",
          "items": [
            { "n": 1, "word": "orange", "wordUz": "apelsin", "answer": "an", "whyUz": "o — unli", "scanCorrect": true },
            { "n": 2, "word": "umbrella", "wordUz": "soyabon", "answer": "an", "whyUz": "u bu yerda 'am-' deb o'qiladi → unli", "commonMistake": { "wrong": "a", "whyUz": "Qo'lyozmada 'a umbrella' — XATO. 'u' harfi ba'zan undosh (a university), lekin umbrella da unli tovush beradi → an." } },
            { "n": 3, "word": "girl", "wordUz": "qiz", "answer": "a", "whyUz": "g — undosh", "commonMistake": { "wrong": "an", "whyUz": "Qo'lyozmada 'an girl' — XATO. 'g' undosh tovush → a girl." } },
            { "n": 4, "word": "boy", "wordUz": "o'g'il bola", "answer": "a", "whyUz": "b — undosh", "scanCorrect": true },
            { "n": 5, "word": "man", "wordUz": "erkak", "answer": "a", "whyUz": "m — undosh", "scanCorrect": true },
            { "n": 6, "word": "apple", "wordUz": "olma", "answer": "an", "whyUz": "a — unli", "scanCorrect": true },
            { "n": 7, "word": "pencil", "wordUz": "qalam", "answer": "a", "whyUz": "p — undosh", "scanCorrect": true },
            { "n": 8, "word": "bicycle", "wordUz": "velosiped", "answer": "a", "whyUz": "b — undosh", "commonMistake": { "wrong": "an", "whyUz": "Qo'lyozmada 'an bicycle' — XATO. 'b' undosh → a bicycle." } },
            { "n": 9, "word": "woman", "wordUz": "ayol", "answer": "a", "whyUz": "w — undosh", "commonMistake": { "wrong": "an", "whyUz": "Qo'lyozmada 'an woman' — XATO. 'w' undosh tovush → a woman." } },
            { "n": 10, "word": "banana", "wordUz": "banan", "answer": "a", "whyUz": "b — undosh", "commonMistake": { "wrong": "an", "whyUz": "Qo'lyozmada 'an banana' — XATO. So'z ICHIDA unli ko'p bo'lsa ham, faqat BIRINCHI tovush muhim → a banana." } },
            { "n": 11, "word": "hat", "wordUz": "shlyapa", "answer": "a", "whyUz": "h o'qiladi → undosh", "scanCorrect": true },
            { "n": 12, "word": "elephant", "wordUz": "fil", "answer": "an", "whyUz": "e — unli", "commonMistake": { "wrong": "a", "whyUz": "Qo'lyozmada 'a elephant' — XATO. 'e' unli → an elephant." } }
          ]
        }
