      "exercises": [
        {
          "ref": "11",
          "type": "dialogue_fill",
          "instructionEn": "Fill in the gaps with the correct personal pronouns.",
          "instructionUz": "Bo'shliqlarni to'g'ri shaxs olmoshi bilan to'ldiring.",
          "explanationUz": "Javobdagi ism yoki fe'l olmoshni aytib beradi:\n• Margaret (ayol) → She\n• John (erkak) → He\n• Jane and Tony (ikki kishi) → they\n• umbrella (narsa) → it",
          "items": [
            {
              "n": 1,
              "lines": [
                { "who": "A", "textEn": "Where are ___ from?", "answer": "you", "given": true },
                { "who": "B", "textEn": "___ 'm from Italy.", "answer": "I" }
              ],
              "whyUz": "''m' faqat I bilan."
            },
            {
              "n": 2,
              "lines": [
                { "who": "A", "textEn": "Who are ___ ?", "answer": "they" },
                { "who": "B", "textEn": "___ are my neighbours, Ann and David.", "answer": "They" }
              ],
              "whyUz": "Javobda ikki kishi (Ann va David) → they.",
              "commonMistake": { "wrong": "you / We", "whyUz": "Qo'lyozmada 'you' va 'We' — XATO. Gap Ann va David haqida, ya'ni UCHINCHI shaxs ko'plik → they / They." }
            },
            {
              "n": 3,
              "lines": [
                { "who": "A", "textEn": "How old is Margaret?", "given": true },
                { "who": "B", "textEn": "___ is eighteen.", "answer": "She" }
              ],
              "whyUz": "Margaret — ayol ismi → She."
            },
            {
              "n": 4,
              "lines": [
                { "who": "A", "textEn": "Where is John?", "given": true },
                { "who": "B", "textEn": "___ is at the party.", "answer": "He" }
              ],
              "whyUz": "John — erkak ismi → He."
            },
            {
              "n": 5,
              "lines": [
                { "who": "A", "textEn": "Are Jane and Tony from London?", "given": true },
                { "who": "B", "textEn": "Yes, ___ are.", "answer": "they" }
              ],
              "whyUz": "Ikki kishi → they."
            },
            {
              "n": 6,
              "lines": [
                { "who": "A", "textEn": "Is this your umbrella?", "given": true },
                { "who": "B", "textEn": "Yes, ___ is.", "answer": "it" }
              ],
              "whyUz": "Soyabon — narsa → it."
            }
          ]
        },
        {
          "ref": "12",
          "type": "dialogue_fill",
          "instructionEn": "Fill in am, is, are, 's, 're, 'm, aren't or isn't.",
          "instructionUz": "am, is, are, 's, 're, 'm, aren't yoki isn't dan mosini qo'ying.",
          "explanationUz": "Unit 1 ning yakuniy mashqi — barcha shakllar bir joyda.\nSavol → to'liq shakl (Is/Are).\nInkor javob → qisqa (isn't/aren't).\nTuzatish gapi → is/are yoki 's/'re.",
          "items": [
            {
              "n": 1,
              "lines": [
                { "who": "A", "textEn": "___ Ann from Poland?", "answer": "Is" },
                { "who": "B", "textEn": "No, she ___ . She ___ from Spain.", "answers": ["isn't", "is"], "alt": ["isn't", "'s"] }
              ],
              "whyUz": "Ann — ayol → Is / isn't / She's."
            },
            {
              "n": 2,
              "lines": [
                { "who": "A", "textEn": "What ___ your favourite sport?", "answer": "is" },
                { "who": "B", "textEn": "My favourite sport ___ football.", "answer": "is" }
              ],
              "whyUz": "'sport' — birlik narsa → is."
            },
            {
              "n": 3,
              "lines": [
                { "who": "A", "textEn": "___ they from Finland?", "answer": "Are" },
                { "who": "B", "textEn": "No, they ___ . They ___ British.", "answers": ["aren't", "are"], "alt": ["aren't", "'re"] }
              ],
              "whyUz": "they → Are / aren't / They're."
            },
            {
              "n": 4,
              "lines": [
                { "who": "A", "textEn": "___ Bob ten years old?", "answer": "Is" },
                { "who": "B", "textEn": "No, he ___ . He ___ thirteen.", "answers": ["isn't", "is"], "alt": ["isn't", "'s"] }
              ],
              "whyUz": "Bob — erkak → Is / isn't / He's."
            },
            {
              "n": 5,
              "lines": [
                { "who": "A", "textEn": "How old ___ you?", "answer": "are" },
                { "who": "B", "textEn": "I ___ forty-four.", "answer": "am", "alt": "'m" }
              ],
              "whyUz": "you → are. Javobda I → am."
            }
          ]
        }
      ]
    }
