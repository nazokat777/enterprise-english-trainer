   "rule": {
    "titleUz": "have got — egalik bildirish",
    "explanationUz": "'have got' — 'bor' ma'nosini beradi (egalik).\nO'zbekchada 'Menda it bor' deymiz — inglizchada 'I have got a dog'.\n\nEGAGA qarab ikki shakl:\n• I / you / we / they → HAVE got\n• he / she / it → HAS got\n\nOg'zaki nutqda qisqaradi: I've got, he's got.\nDIQQAT: he's — bu 'he is' ham, 'he has' ham bo'lishi mumkin.\nFarqni 'got' aytib beradi: 'he's got' = he HAS got.",
    "affirmative": [
     {
      "subject": "I/you/we/they",
      "full": "I have got",
      "short": "I've got",
      "uz": "menda ... bor"
     },
     {
      "subject": "he/she/it",
      "full": "he has got",
